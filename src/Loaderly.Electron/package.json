{
  "name": "loaderly",
  "productName": "Loaderly",
  "version": "2.1.3",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-designer.mjs && tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "prepare:desktop-tools": "tsx scripts/prepare-desktop-tools.ts",
    "predev": "node scripts/build-designer.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.56.1",
    "rcedit": "^5.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.loaderly.app",
    "productName": "Loaderly",
    "copyright": "Copyright © 2026 VOIDKSA. All rights reserved.",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Loaderly",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "minimumSystemVersion": "12.0",
      "category": "public.app-category.video",
      "icon": "../../assets/identity/loaderly-512.png",
      "artifactName": "Loaderly-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/tools",
          "to": "tools"
        },
        {
          "from": "../../assets/identity/loaderly-512.png",
          "to": "assets/identity/loaderly-512.png"
        },
        {
          "from": "public/fonts/NotoSansArabic.ttf",
          "to": "fonts/NotoSansArabic.ttf"
        },
        {
          "from": "../../LICENSE.md",
          "to": "LICENSE.md"
        },
        {
          "from": "../../NOTICE",
          "to": "NOTICE"
        },
        {
          "from": "../../docs/DESKTOP-PREVIEW.md",
          "to": "START-HERE.md"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "../../assets/identity/loaderly-512.png",
      "artifactName": "Loaderly-${version}-linux-${arch}.${ext}",
      "maintainer": "VOIDKSA <voidksa@users.noreply.github.com>",
      "extraResources": [
        {
          "from": "build/tools",
          "to": "tools"
        },
        {
          "from": "../../assets/identity/loaderly-512.png",
          "to": "assets/identity/loaderly-512.png"
        },
        {
          "from": "public/fonts/NotoSansArabic.ttf",
          "to": "fonts/NotoSansArabic.ttf"
        },
        {
          "from": "../../LICENSE.md",
          "to": "LICENSE.md"
        },
        {
          "from": "../../NOTICE",
          "to": "NOTICE"
        },
        {
          "from": "../../docs/DESKTOP-PREVIEW.md",
          "to": "START-HERE.md"
        }
      ],
      "syncDesktopName": true
    },
    "publish": null
  },
  "description": "Download, organize and edit video and audio with Loaderly.",
  "author": {
    "name": "VOIDKSA",
    "url": "https://github.com/voidksa"
  },
  "homepage": "https://loaderly.app",
  "license": "SEE LICENSE IN LICENSE.md",
  "desktopName": "com.loaderly.app.desktop"
}
