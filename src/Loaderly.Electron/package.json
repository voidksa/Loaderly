{
  "name": "loaderly",
  "productName": "Loaderly",
  "version": "2.3.2",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-designer.mjs && tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "prepare:desktop-tools": "tsx scripts/prepare-desktop-tools.ts",
    "predev": "node scripts/build-designer.mjs",
    "build:local-ai": "node scripts/build-local-ai.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "x11": "2.3.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.56.1",
    "rcedit": "^5.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.loaderly.app",
    "productName": "Loaderly",
    "copyright": "Copyright Â© 2026 VOIDKSA. All rights reserved.",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../assets/loaderly.ico",
      "extraResources": [
        {
          "from": "build/native/LoaderlyStartupTask.exe",
          "to": "native/LoaderlyStartupTask.exe"
        },
        {
          "from": "build/native/LoaderlyStoreUpdates.exe",
          "to": "native/LoaderlyStoreUpdates.exe"
        },
        {
          "from": "../../assets/loaderly.ico",
          "to": "assets/loaderly.ico"
        },
        {
          "from": "../../assets/identity/loaderly-512.png",
          "to": "assets/identity/loaderly-512.png"
        },
        {
          "from": "build/local-ai",
          "to": "local-ai"
        },
        {
          "from": "../../tools/windows",
          "to": "tools"
        },
        {
          "from": "public/fonts/NotoSansArabic.ttf",
          "to": "fonts/NotoSansArabic.ttf"
        },
        {
          "from": "../../LICENSE.md",
          "to": "LICENSE.md"
        },
        {
          "from": "../../NOTICE",
          "to": "NOTICE"
        },
        {
          "from": "../../docs/INSTALLATION.md",
          "to": "START-HERE.md"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Loaderly",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "../../assets/loaderly.ico",
      "uninstallerIcon": "../../assets/loaderly.ico"
    },
    "mac": {
      "asarUnpack": [
        "node_modules/electron-liquid-glass/prebuilds/**/*.node"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "minimumSystemVersion": "12.0",
      "category": "public.app-category.video",
      "icon": "../../assets/identity/loaderly-512.png",
      "artifactName": "Loaderly-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/tools",
          "to": "tools"
        },
        {
          "from": "../../assets/identity/loaderly-512.png",
          "to": "assets/identity/loaderly-512.png"
        },
        {
          "from": "public/fonts/NotoSansArabic.ttf",
          "to": "fonts/NotoSansArabic.ttf"
        },
        {
          "from": "../../LICENSE.md",
          "to": "LICENSE.md"
        },
        {
          "from": "../../NOTICE",
          "to": "NOTICE"
        },
        {
          "from": "../../docs/INSTALLATION.md",
          "to": "START-HERE.md"
        },
        {
          "from": "build/local-ai",
          "to": "local-ai"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "../../assets/identity/loaderly-512.png",
      "artifactName": "Loaderly-${version}-linux-${arch}.${ext}",
      "maintainer": "VOIDKSA <voidksa@users.noreply.github.com>",
      "extraResources": [
        {
          "from": "build/tools",
          "to": "tools"
        },
        {
          "from": "../../assets/identity/loaderly-512.png",
          "to": "assets/identity/loaderly-512.png"
        },
        {
          "from": "public/fonts/NotoSansArabic.ttf",
          "to": "fonts/NotoSansArabic.ttf"
        },
        {
          "from": "../../LICENSE.md",
          "to": "LICENSE.md"
        },
        {
          "from": "../../NOTICE",
          "to": "NOTICE"
        },
        {
          "from": "../../docs/INSTALLATION.md",
          "to": "START-HERE.md"
        },
        {
          "from": "build/local-ai",
          "to": "local-ai"
        }
      ],
      "syncDesktopName": true
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "appImage": {
      "artifactName": "Loaderly-${version}-${arch}.${ext}"
    },
    "afterAllArtifactBuild": "scripts/finalize-appimage.cjs",
    "deb": {
      "desktop": {
        "entry": {
          "Icon": "/opt/Loaderly/resources/assets/identity/loaderly-512.png"
        }
      }
    },
    "publish": null,
    "beforePack": "scripts/check-local-ai.cjs"
  },
  "description": "Download, organize and edit video and audio with Loaderly.",
  "author": {
    "name": "VOIDKSA",
    "url": "https://github.com/voidksa"
  },
  "homepage": "https://loaderly.app",
  "license": "SEE LICENSE IN LICENSE.md",
  "desktopName": "com.loaderly.app.desktop",
  "optionalDependencies": {
    "electron-liquid-glass": "1.1.1"
  }
}
